{
  "name": "splicedd",
  "private": true,
  "version": "3.0.0",
  "type": "module",
  "description": "A Chrome extension that adds sample downloading and drag-to-DAW to splice.com.",
  "scripts": {
    "build": "node build.mjs",
    "dev": "node build.mjs --watch",
    "typecheck": "tsc --noEmit",
    "zip": "node build.mjs && cd dist && zip -qr ../splicedd-chrome-extension.zip ."
  },
  "dependencies": {
    "lucide-react": "^1.24.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@types/chrome": "^0.2.7",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.0.0",
    "typescript": "^5.8.0",
    "vite": "^6.3.5"
  }
}
